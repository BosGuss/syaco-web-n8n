# Append these to .env (and the same keys, empty, to .env.example). Never commit real values.

POSTGRES_PASSWORD=change-me

# Optional. Defaults to gemini-3.5-flash-lite when empty.
GEMINI_MODEL=gemini-3.5-flash-lite

# Public base URL of n8n. n8n builds webhook URLs from it.
# Local only:           http://localhost:5678/
# From phone / anywhere: your Cloudflare Tunnel or Tailscale Funnel URL, e.g. https://n8n.example.com/
WEBHOOK_URL=http://localhost:5678/
# Same host, no trailing slash needed. Used for the review link in Discord.
REVIEW_BASE_URL=http://localhost:5678

# Discord: Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Bluesky: use an App Password (Settings > Privacy and security > App passwords), never the account password.
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
