# n8n Environment Configuration Template
N8N_SANDBOX_VERSION=1.4.0

# Google Gemini API Key (Replace with your actual API key)
GEMINI_API_KEY=your_gemini_api_key_here
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Sandbox API Credentials
SANDBOX_API_KEYS=your_sandbox_api_key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=your_runner_registration_token
SANDBOX_API_RUNNER_API_KEY=your_runner_api_key
SANDBOX_RUNNER_API_KEYS=your_runner_api_key

N8N_SANDBOX_SERVICE_API_KEY=your_sandbox_service_api_key

# PostgreSQL Connection Settings (Local & External Server)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=syaco_n8n_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Gemini Model Selection
GEMINI_MODEL=gemini-3.5-flash-lite

# Webhook & Review URLs
WEBHOOK_URL=http://localhost:5678/
REVIEW_BASE_URL=http://localhost:5678

# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Bluesky Credentials
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
