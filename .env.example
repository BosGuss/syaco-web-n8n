# n8n Environment Configuration Template
N8N_SANDBOX_VERSION=1.4.0

# Google Gemini API Key (Replace with your actual API key)
GEMINI_API_KEY=your_gemini_api_key_here
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Gemini Model Selection
GEMINI_MODEL=gemini-3.5-flash-lite

# Sandbox API Credentials
SANDBOX_API_KEYS=your_sandbox_api_key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=your_runner_registration_token
SANDBOX_API_RUNNER_API_KEY=your_runner_api_key
SANDBOX_RUNNER_API_KEYS=your_runner_api_key
N8N_SANDBOX_SERVICE_API_KEY=your_sandbox_service_api_key

# PostgreSQL Connection Settings (Local & External Server)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=syaco_n8n_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Webhook & Review URLs
WEBHOOK_URL=http://localhost:5678/
REVIEW_BASE_URL=http://localhost:5678

# Discord Webhook (ใช้เมื่อส่งข้อความผ่าน Webhook)
DISCORD_WEBHOOK_URL=

# Discord Bot API (ใช้เมื่อส่งข้อความผ่าน Bot)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Discord Admin Allowlist (คั่นด้วย comma เช่น 123456789,987654321 เฉพาะ user id เหล่านี้ที่สามารถกด Approve / Publish / Edit ได้)
DISCORD_ADMIN_IDS=

# Discord OAuth2 Credential (ใช้สำหรับ OAuth2 ใน n8n)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bluesky Credentials
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# Dev.to Credentials
# Generate at: https://dev.to/settings/extensions (DEV Community API Keys)
DEVTO_API_KEY=your_devto_api_key_here
# Legacy cookie for search (optional):
DEVTO_COOKIE=remember_user_token=your_token_here

# SyaCo Solutions API
SYACO_API_URL=https://www.syaco.co.th/api/solutions
SYACO_API_TOKEN=your_syaco_api_token_here


