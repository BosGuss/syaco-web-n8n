    {
      "parameters": {
        "jsCode": "const processed = new Set($('Load Processed IDs').all().map(i => String(i.json.solution_id)));\nconst raw = $('Get Current Solutions').first()?.json || [];\nconst list = Array.isArray(raw) ? raw : (raw.data || [raw]);\n\nconst newSolutions = list.filter(s => s && s.id && !processed.has(String(s.id)));\n\nreturn newSolutions.map(s => ({\n  json: {\n    id: String(s.id),\n    titleEn: s.titleEn || '',\n    titleTh: s.titleTh || '',\n    descEn: s.content?.en?.hero?.description || s.descEn || '',\n    descTh: s.content?.th?.hero?.description || s.descTh || '',\n    link: s.link || `/solutions/${s.id}`,\n    url: `https://www.syaco.co.th${s.link || `/solutions/${s.id}`}`\n  }\n}));"
      },
      "id": "f2-node-filter-new",
      "name": "Filter New Solutions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "f2-cond-has-new",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
