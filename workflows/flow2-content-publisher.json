    {
      "parameters": {
        "jsCode": "const sol = $('Build AI Prompts for Call A & B').first().json.solution;\n\n// 1. Parse Call A\nconst cA = $('Call Gemini AI (Micro & Dev.to)').first()?.json?.candidates || [];\nconst textA = cA[0]?.content?.parts?.[0]?.text || '{}';\nlet dataA = {};\ntry { dataA = JSON.parse(textA); } catch(e) {}\n\n// 2. Parse Call B\nconst cB = $('Call Gemini AI (In-depth & Manual)').first()?.json?.candidates || [];\nconst textB = cB[0]?.content?.parts?.[0]?.text || '{}';\nlet dataB = {};\ntry { dataB = JSON.parse(textB); } catch(e) {}\n\n// 3. Dev.to Tag Sanitizer\nfunction sanitizeDevtoTags(rawTags) {\n  return (rawTags || [])\n    .map(t => String(t || '').toLowerCase().replace(/[^a-z0-9]/g, ''))\n    .filter(t => t.length >= 2)\n    .slice(0, 4);\n}\n\nconst devtoTags = sanitizeDevtoTags(dataA.devtoArticle?.tags || ['tech', 'architecture']);\nconst hashnodeTags = (dataB.hashnodeArticle?.tags || ['tech', 'architecture']).slice(0, 5);\nconst manualTags = (dataB.manualArticle?.tags || ['tech', 'enterprise']).slice(0, 5);\nconst blueskyTags = ['syaco', 'tech'];\n\n// 4. Bluesky Text & Facet\nlet blueskyText = String(dataA.blueskyPost || '').trim();\nif (!blueskyText.includes(sol.url)) {\n  blueskyText += ` ${sol.url}`;\n}\nif (blueskyText.length > 295) {\n  const maxTxt = 295 - sol.url.length - 1;\n  blueskyText = blueskyText.slice(0, maxTxt) + ' ' + sol.url;\n}\n\nreturn [{\n  json: {\n    solution_id: String(sol.id),\n    solution_title: sol.titleEn || sol.titleTh,\n    bluesky_title: (sol.titleTh || sol.titleEn).slice(0, 100),\n    bluesky_content: blueskyText,\n    bluesky_tags: blueskyTags,\n    devto_title: String(dataA.devtoArticle?.title || sol.titleTh).trim(),\n    devto_content: String(dataA.devtoArticle?.bodyMarkdown || sol.descTh).trim(),\n    devto_tags: devtoTags,\n    hashnode_title: String(dataB.hashnodeArticle?.title || sol.titleTh).trim(),\n    hashnode_content: String(dataB.hashnodeArticle?.bodyMarkdown || sol.descTh).trim(),\n    hashnode_tags: hashnodeTags,\n    manual_title: String(dataB.manualArticle?.title || sol.titleTh).trim(),\n    manual_content: String(dataB.manualArticle?.bodyMarkdown || sol.descTh).trim(),\n    manual_tags: manualTags\n  }\n}];"
      },
