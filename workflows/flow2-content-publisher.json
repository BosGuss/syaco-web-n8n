    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processed_solutions (solution_id, solution_title, status, first_seen_at, updated_at)\nVALUES ($1, $2, 'processing', NOW(), NOW())\nON CONFLICT (solution_id) DO UPDATE \n  SET status = 'processing', updated_at = NOW()\nWHERE processed_solutions.status <> 'completed'\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.titleEn || $json.titleTh] }}"
        }
      },
      "id": "f2-node-lock-processing",
      "name": "Lock Solution Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1380,
        360
      ],
      "credentials": {
        "postgres": {
          "id": "ppHdQYPLGXKAxrFp",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const sol = $('Split In Batches').first().json;\n\n// Prompt A: Bluesky (Micro <= 300 chars TH) + Dev.to (Technical Markdown for developers)\nconst promptA = [\n  'You are a tech writer for SyaCo (enterprise software engineering firm).',\n  'Create 2 content formats for the new enterprise solution described below.',\n  '',\n  'Solution Context:',\n  `Title: ${sol.titleTh} (${sol.titleEn})`,\n  `Description: ${sol.descTh}`,\n  `URL: ${sol.url}`,\n  '',\n  'Format 1: Bluesky Post (blueskyPost)',\n  '- Short, punchy, informative post in Thai strictly under 300 characters.',\n  `- MUST include the exact URL: ${sol.url}`,\n  '- Engaging hook for enterprise IT managers and developers.',\n  '',\n  'Format 2: Dev.to Article (devtoArticle)',\n  '- High-quality technical guide / architectural overview in Markdown.',\n  '- Title in Thai or bilingual.',\n  `- Include practical problem solving and introduce the SyaCo solution with natural backlink: ${sol.url}`,\n  '- Tags: 3 to 4 tags strictly alphanumeric [a-z0-9] (e.g. devops, automation, architecture, webdev).',\n  '',\n  'Return valid JSON only matching the schema.'\n].join('\\n');\n\nconst geminiBodyA = {\n  contents: [{ parts: [{ text: promptA }] }],\n  generationConfig: {\n    temperature: 0.7,\n    responseMimeType: 'application/json',\n    responseSchema: {\n      type: 'OBJECT',\n      properties: {\n        blueskyPost: { type: 'STRING' },\n        devtoArticle: {\n          type: 'OBJECT',\n          properties: {\n            title: { type: 'STRING' },\n            bodyMarkdown: { type: 'STRING' },\n            tags: { type: 'ARRAY', items: { type: 'STRING' } }\n          },\n          required: ['title', 'bodyMarkdown', 'tags']\n        }\n      },\n      required: ['blueskyPost', 'devtoArticle']\n    }\n  }\n};\n\n// Prompt B: Hashnode Article + Manual Enterprise Press Release / Tech Article\nconst promptB = [\n  'You are a senior tech evangelist for SyaCo.',\n  'Create 2 long-form technical content pieces for this new enterprise solution:',\n  '',\n  'Solution Context:',\n  `Title: ${sol.titleTh} (${sol.titleEn})`,\n  `Description: ${sol.descTh}`,\n  `URL: ${sol.url}`,\n  '',\n  'Format 1: Hashnode Article (hashnodeArticle)',\n  '- In-depth software architecture and systems engineering article in Markdown.',\n  '- High technical depth, code snippets or architectural diagrams in ASCII/Mermaid where helpful.',\n  `- Mentions SyaCo\\'s solution: ${sol.url}`,\n  '- Tags: 3 to 5 tags.',\n  '',\n  'Format 2: Manual Long-form Article (manualArticle)',\n  '- Professional enterprise article in Thai suitable for Blognone, TechTalkThai, Medium, or LinkedIn.',\n  '- Clear business problem, technical solution, architectural benefits, and next steps.',\n  `- Includes link: ${sol.url}`,\n  '- Tags: 3 to 5 tags in Thai or English.',\n  '',\n  'Return valid JSON only matching the schema.'\n].join('\\n');\n\nconst geminiBodyB = {\n  contents: [{ parts: [{ text: promptB }] }],\n  generationConfig: {\n    temperature: 0.7,\n    responseMimeType: 'application/json',\n    responseSchema: {\n      type: 'OBJECT',\n      properties: {\n        hashnodeArticle: {\n          type: 'OBJECT',\n          properties: {\n            title: { type: 'STRING' },\n            bodyMarkdown: { type: 'STRING' },\n            tags: { type: 'ARRAY', items: { type: 'STRING' } }\n          },\n          required: ['title', 'bodyMarkdown', 'tags']\n        },\n        manualArticle: {\n          type: 'OBJECT',\n          properties: {\n            title: { type: 'STRING' },\n            bodyMarkdown: { type: 'STRING' },\n            tags: { type: 'ARRAY', items: { type: 'STRING' } }\n          },\n          required: ['title', 'bodyMarkdown', 'tags']\n        }\n      },\n      required: ['hashnodeArticle', 'manualArticle']\n    }\n  }\n};\n\nreturn [{\n  json: {\n    solution: sol,\n    geminiBodyA,\n    geminiBodyB\n  }\n}];"
      },
      "id": "f2-node-build-prompts",
      "name": "Build AI Prompts for Call A & B",
