      "id": "f2-node-platform-router",
      "name": "Platform Switch Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        920,
        1060
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bsky.social/xrpc/com.atproto.server.createSession",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { identifier: $env.BLUESKY_HANDLE, password: $env.BLUESKY_APP_PASSWORD } }}",
        "options": {}
      },
      "id": "f2-node-bsky-session",
      "name": "Bluesky Create Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        860
      ]
    },
    {
      "parameters": {
        "jsCode": "const draft = $('Atomic Lock Draft for Publishing').first().json;\nconst session = $input.first().json;\nconst text = draft.content_markdown;\n\n// Compute UTF-8 Facet for link\nconst urlMatch = text.match(/https?:\\/\\/[^\\s]+/);\nconst facets = [];\nif (urlMatch) {\n  const link = urlMatch[0];\n  const linkIndex = text.indexOf(link);\n  const byteStart = Buffer.byteLength(text.slice(0, linkIndex), 'utf8');\n  const byteEnd = byteStart + Buffer.byteLength(link, 'utf8');\n  facets.push({\n    index: { byteStart, byteEnd },\n    features: [{ \"$type\": \"app.bsky.richtext.facet#link\", uri: link }]\n  });\n}\n\nconst record = {\n  \"$type\": \"app.bsky.feed.post\",\n  text: text,\n  createdAt: new Date().toISOString(),\n  facets: facets\n};\n\nreturn [{\n  json: {\n    draftId: draft.id,\n    accessJwt: session.accessJwt,\n    did: session.did,\n    handle: session.handle,\n    blueskyBody: {\n      repo: session.did,\n      collection: \"app.bsky.feed.post\",\n      record: record\n    }\n  }\n}];"
      },
      "id": "f2-node-bsky-payload",
      "name": "Compute Bluesky UTF-8 Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        860
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bsky.social/xrpc/com.atproto.repo.createRecord",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.accessJwt }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.blueskyBody }}",
        "options": {}
      },
      "id": "f2-node-bsky-post",
      "name": "Post to Bluesky API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        860
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_drafts\nSET status = 'posted', posted_url = $1, posted_at = NOW(), error_message = NULL\nWHERE id = $2\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [\n  'https://bsky.app/profile/' + $('Compute Bluesky UTF-8 Payload').first().json.handle + '/post/' + ($json.uri ? $json.uri.split('/').pop() : ''),\n  $('Compute Bluesky UTF-8 Payload').first().json.draftId\n] }}"
        }
      },
      "id": "f2-node-bsky-update-db",
      "name": "Update DB Bluesky Posted",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1840,
        860
      ],
      "credentials": {
        "postgres": {
          "id": "ppHdQYPLGXKAxrFp",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const draft = $('Atomic Lock Draft for Publishing').first().json;\nreturn [{\n  json: {\n    draftId: draft.id,\n    devtoBody: {\n      article: {\n        title: draft.title_th,\n        body_markdown: draft.content_markdown,\n        published: true,\n        tags: draft.tags || ['architecture', 'tech']\n      }\n    }\n  }\n}];"
      },
      "id": "f2-node-devto-payload",
      "name": "Build Dev.to Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        1000
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dev.to/api/articles",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.DEVTO_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.devtoBody }}",
        "options": {}
