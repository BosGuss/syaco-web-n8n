        "options": {
          "queryReplacement": "={{ [$('Atomic Lock Draft for Publishing').first().json.id] }}"
        }
      },
      "id": "f2-node-manual-update-db",
      "name": "Update DB Manual Ready",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1400,
