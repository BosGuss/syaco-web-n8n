      "position": [
        680,
        1060
      ],
      "credentials": {
        "postgres": {
          "id": "ppHdQYPLGXKAxrFp",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
