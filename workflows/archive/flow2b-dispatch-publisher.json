      "id": "f2-node-devto-post",
      "name": "POST to Dev.to API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        1000
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_drafts\nSET status = 'posted', posted_url = $1, posted_at = NOW(), error_message = NULL\nWHERE id = $2\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.url || ('https://dev.to/' + $json.id), $('Build Dev.to Payload').first().json.draftId] }}"
        }
