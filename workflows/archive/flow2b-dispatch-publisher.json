      "name": "Update DB Hashnode Posted",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1620,
        1140
      ],
      "credentials": {
        "postgres": {
          "id": "ppHdQYPLGXKAxrFp",
