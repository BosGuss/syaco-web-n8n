      "id": "f2-node-devto-update-db",
      "name": "Update DB Dev.to Posted",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1620,
        1000
      ],
      "credentials": {
        "postgres": {
          "id": "ppHdQYPLGXKAxrFp",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const draft = $('Atomic Lock Draft for Publishing').first().json;\nreturn [{\n  json: {\n    draftId: draft.id,\n    hashnodeBody: {\n      query: `mutation PublishPost($input: PublishPostInput!) { publishPost(input: $input) { post { id url title } } }`,\n      variables: {\n        input: {\n          title: draft.title_th,\n          contentMarkdown: draft.content_markdown,\n          publicationId: process.env.HASHNODE_PUBLICATION_ID || 'dummy_publication_id',\n          tags: (draft.tags || ['tech']).map(t => ({ name: t, slug: t.toLowerCase() }))\n        }\n      }\n    }\n  }\n}];"
      },
      "id": "f2-node-hashnode-payload",
      "name": "Build Hashnode Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        1140
